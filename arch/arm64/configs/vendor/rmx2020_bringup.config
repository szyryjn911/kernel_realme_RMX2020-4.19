# RMX2020 bring-up overrides: apply LAST (after mt6768_defconfig and rmx2020.config)
# Matches the 4.14 tree where LTO/CFI/SCS were off; 4.19 base defaults them on, which
# panics on 4.14-style indirect calls in the ported oplus code.
# CONFIG_LTO_CLANG is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_SHADOW_CALL_STACK is not set
CONFIG_LTO_NONE=y
# CONFIG_RANDOMIZE_BASE is not set
CONFIG_CMDLINE="console=tty0 console=ttyMT3,921600n1 root=/dev/ram vmalloc=496M slub_max_order=0 slub_debug=0 "
# Camera sensors are not ported yet: empty list -> camera is unavailable but boot is not blocked
CONFIG_CUSTOM_KERNEL_IMGSENSOR=""
# smaller/faster build (the 4.14 tree had it off); kallsyms stays on
# CONFIG_DEBUG_INFO is not set
